# Configuration publique de l'app mobile HALO Comptoir.
# Copiez ce fichier vers `.env.local` (ignoré par git) et renseignez les valeurs.
#
# Ce sont EXACTEMENT les valeurs publiques déjà utilisées par le web :
#   EXPO_PUBLIC_SUPABASE_URL      = NEXT_PUBLIC_SUPABASE_URL
#   EXPO_PUBLIC_SUPABASE_ANON_KEY = NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# JAMAIS de clé service-role ici : tout ce qui est préfixé EXPO_PUBLIC_ est
# embarqué dans le bundle et lisible par n'importe qui. `readConfig` refuse
# d'ailleurs de démarrer si la clé fournie est une clé service-role.

EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Base des appels métier (routes /api de l'app Next). Facultatif.
EXPO_PUBLIC_API_BASE_URL=https://app.halocard.ch
