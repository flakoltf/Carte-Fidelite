# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
certs/
# les worktrees d'agents lient certs en symlink — « certs/ » ne couvre pas un lien
certs

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# secrets locaux (jamais committés) — credentials de comptes démo
*.local.md
DEMO-ADMIN.local.md

# vercel
.vercel

# superpowers brainstorm scratch (visual companion)
.superpowers/

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code worktrees & local state
.claude/
