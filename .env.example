# =============================================================================
# HaloCard — variables d'environnement (modèle)
# Copier en `.env.local` et renseigner. NE JAMAIS committer `.env.local`.
# En production : définir ces variables sur Vercel (Settings → Environment Variables).
# =============================================================================

# ---- Supabase --------------------------------------------------------------
# Projet : WalletCard. URL publique + clés.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=             # clé anon (publique, respecte la RLS)
SUPABASE_SERVICE_ROLE_KEY=                 # SECRET — bypass RLS, serveur uniquement

# ---- URLs application ------------------------------------------------------
# Host permanent utilisé pour la webServiceURL des passes Wallet (gravée dans
# chaque pass émis). En prod : https://app.halocard.ch — NE PLUS LE CHANGER une
# fois de vrais passes émis. En dev, laisser vide (fallback localhost).
NEXT_PUBLIC_BASE_URL=https://app.halocard.ch
APPLE_WEB_SERVICE_URL=                     # optionnel : override explicite du webServiceURL Apple

# ---- Apple Wallet ----------------------------------------------------------
APPLE_PASS_TYPE_ID=pass.com.walletcard.fidelite
APPLE_TEAM_ID=
NEXT_PUBLIC_APPLE_WALLET_ENABLED=true
APNS_HOST=api.push.apple.com              # api.sandbox.push.apple.com en test
# Dev : chemins vers les fichiers de certificats (dans certs/, gitignored)
SIGNER_CERT_PATH=certs/signerCert.pem
SIGNER_KEY_PATH=certs/signerKey.pem
WWDR_PEM_PATH=certs/wwdr.pem
SIGNER_KEY_PASSPHRASE=
# Prod (Vercel) : mêmes certificats encodés en base64 (pas de fichiers sur disque)
SIGNER_CERT_BASE64=
SIGNER_KEY_BASE64=
WWDR_PEM_BASE64=

# ---- Google Wallet ---------------------------------------------------------
GOOGLE_ISSUER_ID=
GOOGLE_WALLET_ORIGINS=https://app.halocard.ch
GOOGLE_PUSH_ENABLED=true
# Dev : fichier certs/credentials.json (gitignored). Prod : JSON complet en variable.
GOOGLE_CREDENTIALS_JSON=

# ---- Sécurité / signatures -------------------------------------------------
QR_SIGNATURE_SECRET=        # >= 32 caractères aléatoires — signe les QR
CRON_SECRET=                # protège les routes /api/cron/*
IMPERSONATION_SECRET=       # signe les jetons du mode concierge (impersonation admin)

# ---- Rate limiting (Upstash Redis) -----------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=HaloCard <no-reply@halocard.ch>

# ---- Observabilité (Sentry) ------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Stripe (abonnements) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
